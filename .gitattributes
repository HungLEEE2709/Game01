# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for common code and Unity files
*.cs     text eol=lf
*.shader text eol=lf
*.cginc  text eol=lf
*.hlsl   text eol=lf
*.txt    text eol=lf
*.meta   text eol=lf
*.asmdef text eol=lf

# Binary files (do not modify line endings)
*.png   binary
*.jpg   binary
*.fbx   binary
*.prefab binary
*.unity binary
*.mp3   binary
*.wav   binary
*.ogg   binary
*.dll   binary
